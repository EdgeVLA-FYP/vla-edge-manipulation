# Byte-compiled / optimized files
__pycache__/
*.py[codz]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Environments
.env
.envrc
.venv
env/
venv/
ENV/

# Tooling caches (pre-commit formatting/linting, once set up)
.ruff_cache/
.mypy_cache/

# Jupyter (notebooks/ is exploration-only, per docs/decisions.md convention)
.ipynb_checkpoints

# OS junk
.DS_Store
Thumbs.db

# Claude Code: personal local skills, not shared via git
.claude/skills/

# Project-specific: personal machine config, never someone else's port/path
configs/*.yaml
!configs/*.yaml.example

# Large binaries — datasets/checkpoints/videos live on the HF Hub, not git
*.mp4
*.gif
outputs/
datasets/
checkpoints/
*.pt
*.safetensors
