<mujoco model="so101_scene">
    <include file="so101_new_calib_camera.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.2" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />
        <!-- vla_edge_manipulation: fixed observation camera framing the pick-cube
             workspace (cube + bin below), see NOTICE.md -->
        <camera name="front" pos="0.55 0.05 0.32" xyaxes="-0.3905 0.9206 0 -0.5908 -0.2507 0.7669"
            fovy="55" />

        <!-- Pick-cube task workspace (configs/task_pickcube.yaml.example). Cube
             starts at the center of the configured cube_area_cm spawn region;
             per-episode randomization within that region is the recording
             script's job, not baked into this static scene. -->
        <body name="cube" pos="0.28 0 0.01">
            <freejoint />
            <geom name="cube" type="box" size="0.01 0.01 0.01" rgba="0.8 0.1 0.1 1" mass="0.02" />
        </body>

        <!-- Target bin: open-top, ~6cm clear interior, 2cm walls. success_criteria
             (cube_center_within_box_bounds) checks the cube's (x,y) against this
             footprint — see configs/task_pickcube.yaml.example. -->
        <body name="bin" pos="0.28 -0.18 0">
            <geom name="bin_wall_north" type="box" size="0.032 0.002 0.01" pos="0 0.032 0.01"
                rgba="0.1 0.2 0.7 1" />
            <geom name="bin_wall_south" type="box" size="0.032 0.002 0.01" pos="0 -0.032 0.01"
                rgba="0.1 0.2 0.7 1" />
            <geom name="bin_wall_east" type="box" size="0.002 0.032 0.01" pos="0.032 0 0.01"
                rgba="0.1 0.2 0.7 1" />
            <geom name="bin_wall_west" type="box" size="0.002 0.032 0.01" pos="-0.032 0 0.01"
                rgba="0.1 0.2 0.7 1" />
        </body>
    </worldbody>
</mujoco>
