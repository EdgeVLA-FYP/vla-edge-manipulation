<mujoco model="so101_scene">
    <include file="so101_new_calib_camera.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <!-- Table surface (no separate riser: the arm mounts flush on it, a common
             desktop SO-101 setup). Plain colour, not a debug checker pattern — a
             stand-in for whatever real table/mat this eventually runs on.
             Colour/friction are runtime-overridable from configs/robot_sim.yaml,
             see backends/sim.py connect(). -->
        <geom name="table" size="0 0 0.05" pos="0 0 0" type="plane" rgba="0.5 0.5 0.5 1"
            friction="1.0 0.005 0.0001" />
        <!-- vla_edge_manipulation: observation camera framing the pick-cube
             workspace (cube + bin below); pose is runtime-overridden from config,
             this is the fallback default. See NOTICE.md. -->
        <camera name="front" pos="0.55 0.05 0.32" xyaxes="-0.3905 0.9206 0 -0.5908 -0.2507 0.7669"
            fovy="55" />

        <!-- Pick-cube task workspace (configs/task_pickcube.yaml.example). Size,
             colour, and start position are runtime-overridable from config —
             values here are fallback defaults, not what MuJoCoBackend actually
             uses once connected. Cube position is re-randomized every
             reset_to_home() within the configured cube_area_cm. -->
        <body name="cube" pos="0.28 0 0.01">
            <freejoint />
            <geom name="cube" type="box" size="0.01 0.01 0.01" rgba="0.8 0.1 0.1 1" mass="0.02"
                friction="1.5 0.01 0.0001" />
        </body>

        <!-- Target bin: open-top, ~6cm clear interior, 2cm walls. success_criteria
             (cube_center_within_box_bounds) checks the cube's (x,y) against this
             footprint — see configs/task_pickcube.yaml.example. -->
        <body name="bin" pos="0.28 -0.18 0">
            <geom name="bin_wall_north" type="box" size="0.032 0.002 0.01" pos="0 0.032 0.01"
                rgba="0.1 0.2 0.7 1" />
            <geom name="bin_wall_south" type="box" size="0.032 0.002 0.01" pos="0 -0.032 0.01"
                rgba="0.1 0.2 0.7 1" />
            <geom name="bin_wall_east" type="box" size="0.002 0.032 0.01" pos="0.032 0 0.01"
                rgba="0.1 0.2 0.7 1" />
            <geom name="bin_wall_west" type="box" size="0.002 0.032 0.01" pos="-0.032 0 0.01"
                rgba="0.1 0.2 0.7 1" />
        </body>
    </worldbody>
</mujoco>
